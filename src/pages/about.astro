---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";
---

<Layout title="About | Justin Hoffmann" showNav>
  <section class="about">
    <h1>About Me</h1>

    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}

    <h2>Certifications</h2>

    <div class="skills">
      {profile.certifications.map((cert) => <span>{cert}</span>)}
    </div>

    <h2>Technologies I Work With</h2>

    <div class="tech-columns">
      {
        profile.techColumns.map((column) => (
          <div class="tech-column">
            <h3>{column.title}</h3>
            <div class="skills">
              {column.items.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .about {
    position: relative;
    z-index: 1;

    max-width: 850px;
    margin: 80px auto;
    padding: 2rem;
  }

  .about h1 {
    font-size: clamp(2.2rem, 6vw, 3rem);
    margin-bottom: 2rem;
    color: var(--text);
  }

  .about h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .about p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .tech-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }

  .tech-column h3 {
    color: var(--text);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .skills span {
    background: var(--surface-alt);
    border: 1px solid var(--border-strong);
    padding: 0.5rem 0.95rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
  }

  @media (max-width: 600px) {
    .about {
      margin: 40px auto;
      padding: 1.5rem;
    }
  }
</style>
