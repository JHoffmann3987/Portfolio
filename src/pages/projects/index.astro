---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
---

<Layout title="Projects | Justin Hoffmann" showNav>
  <section class="projects-page">
    <h1>Projects</h1>

    <p class="intro">
      A collection of home lab, infrastructure, and automation projects I've
      built to strengthen my IT skills.
    </p>

    <div class="project-grid">
      {
        projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="project-card">
            <h2>{project.title}</h2>
            <p>{project.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .projects-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3rem);
    margin-bottom: 1rem;
    color: var(--text);
  }

  .intro {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 700px;
    margin-bottom: 3rem;
  }

  .project-grid {
    display: grid;
    gap: 2rem;
  }

  .project-card {
    display: block;
    padding: 2rem;
    border: 1px solid var(--border-alt);
    border-radius: 12px;
    background: var(--surface-card);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .project-card h2 {
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .project-card p {
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .projects-page {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
