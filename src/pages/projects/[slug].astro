---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Justin Hoffmann`} showNav>
  <section class="project">
    <h1>{project.emoji} {project.title}</h1>

    <p class="subtitle">{project.description}</p>

    <div class="tech-list">
      {project.techList.map((tech) => <span>{tech}</span>)}
    </div>

    {
      project.githubUrl && (
        <a
          class="github-link"
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub →
        </a>
      )
    }

    <h2>Overview</h2>

    <p>{project.overview[0]}</p>

    {
      project.overview.length > 1 && (
        <>
          <div class="overview-extra" id="overview-extra" hidden>
            {project.overview.slice(1).map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <button
            type="button"
            class="overview-toggle"
            id="overview-toggle"
            aria-expanded="false"
            aria-controls="overview-extra"
          >
            Read more <span class="chevron">↓</span>
          </button>
        </>
      )
    }

    {
      project.architecture && (
        <>
          <h2>Architecture</h2>
          <div class="architecture">{project.architecture}</div>
        </>
      )
    }

    <h2>Technologies Used</h2>

    <ul>
      {project.technologies.map((tech) => <li>{tech}</li>)}
    </ul>

    <h2>Highlights</h2>

    <ul>
      {project.detailHighlights.map((item) => <li>{item}</li>)}
    </ul>

    <h2>Challenges</h2>

    <ul>
      {project.challenges.map((item) => <li>{item}</li>)}
    </ul>

    <h2>What I Learned</h2>

    <p>{project.learned}</p>

    {
      project.nextSteps && project.nextSteps.length > 0 && (
        <>
          <h2>Next Steps</h2>

          <ul>
            {project.nextSteps.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )
    }

    <div class="gallery">
      <h2>Gallery</h2>

      {
        project.screenshots && project.screenshots.length > 0 ? (
          <div class="screenshot-grid">
            {project.screenshots.map((src, i) => (
              <button
                type="button"
                class="screenshot-trigger"
                data-lightbox-src={src}
                data-lightbox-index={i}
                aria-label={`View screenshot ${i + 1} of ${project.title} full size`}
              >
                <img src={src} alt={`${project.title} screenshot`} loading="lazy" />
              </button>
            ))}
          </div>
        ) : (
          <p>Screenshots of the environment will be added as the project continues to evolve.</p>
        )
      }
    </div>

    <a href="/projects" class="back-link">← Back to all projects</a>

    {
      project.screenshots && project.screenshots.length > 0 && (
        <div class="lightbox" id="lightbox" hidden>
          <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">
            ✕
          </button>

          <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous screenshot">
            ‹
          </button>

          <img src="" alt="" id="lightbox-img" />

          <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next screenshot">
            ›
          </button>
        </div>
      )
    }
  </section>
</Layout>

<script>
  const overviewToggle = document.getElementById("overview-toggle");
  const overviewExtra = document.getElementById("overview-extra");

  if (overviewToggle && overviewExtra) {
    overviewToggle.addEventListener("click", () => {
      const isHidden = overviewExtra.hidden;
      overviewExtra.hidden = !isHidden;
      overviewToggle.setAttribute("aria-expanded", String(isHidden));
      overviewToggle.innerHTML = isHidden
        ? 'Show less <span class="chevron up">↑</span>'
        : 'Read more <span class="chevron">↓</span>';
    });
  }
</script>

{
  project.screenshots && project.screenshots.length > 0 && (
    <script define:vars={{ screenshots: project.screenshots }}>
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const closeBtn = document.getElementById("lightbox-close");
      const prevBtn = document.getElementById("lightbox-prev");
      const nextBtn = document.getElementById("lightbox-next");
      const triggers = document.querySelectorAll(".screenshot-trigger");

      let currentIndex = 0;

      function openLightbox(index) {
        currentIndex = index;
        lightboxImg.src = screenshots[currentIndex];
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        lightbox.hidden = true;
        document.body.style.overflow = "";
      }

      function showDelta(delta) {
        currentIndex = (currentIndex + delta + screenshots.length) % screenshots.length;
        lightboxImg.src = screenshots[currentIndex];
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          openLightbox(Number(trigger.dataset.lightboxIndex));
        });
      });

      closeBtn.addEventListener("click", closeLightbox);
      prevBtn.addEventListener("click", () => showDelta(-1));
      nextBtn.addEventListener("click", () => showDelta(1));

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (lightbox.hidden) return;
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowLeft") showDelta(-1);
        if (e.key === "ArrowRight") showDelta(1);
      });
    </script>
  )
}

<style>
  .project {
    position: relative;
    z-index: 1;

    max-width: 900px;
    margin: 80px auto;
    padding: 2rem;
  }

  .project h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 3rem;
  }

  .tech-list span {
    background: var(--surface-alt);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 10px;
    color: var(--accent-light);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .github-link:hover {
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent-lighter);
    transform: translateY(-2px);
  }

  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: start;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .screenshot-trigger {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    cursor: zoom-in;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .screenshot-trigger:hover,
  .screenshot-trigger:focus-visible {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .screenshot-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .screenshot-grid img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.88);
    padding: 2rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--surface-alt);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--text);
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lightbox-close:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--surface-alt);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lightbox-nav:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }

  .lightbox-prev {
    left: 1.5rem;
  }

  .lightbox-next {
    right: 1.5rem;
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: 1rem;
    }

    .lightbox-nav {
      width: 42px;
      height: 42px;
      font-size: 1.4rem;
    }

    .lightbox-prev {
      left: 0.5rem;
    }

    .lightbox-next {
      right: 0.5rem;
    }

    .lightbox-close {
      top: 0.75rem;
      right: 0.75rem;
    }
  }

  .project h2 {
    margin-top: 3rem;
    color: var(--text);
  }

  .project p,
  .project li {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .project ul {
    padding-left: 1.25rem;
  }

  .overview-extra p {
    margin-top: 1.8rem;
  }

  .overview-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    margin-top: 1rem;
    padding: 0.55rem 1rem;

    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 8px;

    color: var(--accent-light);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;

    cursor: pointer;
    transition: all 0.2s ease;
  }

  .overview-toggle:hover {
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.08);
  }

  .chevron {
    display: inline-block;
  }

  .architecture {
    margin-top: 1rem;
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    font-family: monospace;
    white-space: pre;
    overflow-x: auto;
    color: var(--text-secondary);
  }

  .gallery {
    margin-top: 4rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-top: 3rem;
    color: var(--accent-light);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-lighter);
  }
</style>
