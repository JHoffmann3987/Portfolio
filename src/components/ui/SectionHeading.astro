---
interface Props {
  number: string;
  title: string;
  description?: string;
}

const { number, title, description } = Astro.props;
---

<div class="section-heading">
  <span class="line"></span>

  <div class="content">
    <p class="number">{number}</p>

    <h2>{title}</h2>

    {description && <p class="description">{description}</p>}
  </div>
</div>

<style>
  .section-heading {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .line {
    width: 60px;
    height: 2px;
    background: #3b82f6;
    margin-top: 0.9rem;
    flex-shrink: 0;
  }

  .content {
    flex: 1;
  }

  .number {
    margin: 0;
    color: #3b82f6;
    font-family: monospace;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0.35rem 0 0;
    color: #f8fafc;
    font-size: 2rem;
    font-weight: 700;
  }

  .description {
    margin-top: 1rem;
    color: #94a3b8;
    max-width: 760px;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.75rem;
    }
  }
</style>
