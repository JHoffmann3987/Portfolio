---
import SectionHeading from "./ui/SectionHeading.astro";
import Badge from "./ui/Badge.astro";

const skillGroups = [
  {
    title: "Microsoft 365 & Identity",
    description:
      "The bulk of my ticket queue — provisioning, licensing, MFA policy, and mailbox issues across a rotating set of client tenants.",
    skills: [
      "Microsoft 365",
      "Exchange Online",
      "Entra ID",
      "Intune",
      "Azure Fundamentals",
      "MFA",
      "User Management",
    ],
    projectSlug: "microsoft-365",
  },

  {
    title: "Windows & Active Directory",
    description:
      "Group Policy, permissions, and the occasional domain controller that needs babying — keeping client domains healthy day to day.",
    skills: [
      "Windows 11",
      "Windows Server",
      "Active Directory",
      "Group Policy",
      "DNS",
      "DHCP",
    ],
  },

  {
    title: "Virtualization",
    description:
      "Where the home lab actually lives — a Proxmox host running LXC containers and VMs, snapshotted and backed up like production.",
    skills: [
      "Proxmox VE",
      "Virtual Machines",
      "LXC Containers",
      "Snapshots",
      "Storage",
      "Backups",
    ],
    projectSlug: "proxmox-homelab",
  },

  {
    title: "Linux & Docker",
    description:
      "Every service in the lab runs containerized, defined in Compose files and deployed by Ansible rather than by hand.",
    skills: [
      "Ubuntu Server",
      "Docker",
      "Docker Compose",
      "Linux CLI",
      "Terraform",
      "Ansible",
    ],
    projectSlug: "homelab-iac-observability",
  },

  {
    title: "Networking",
    description:
      "OPNsense firewall rules and 802.1Q VLAN trunking — segmented my home network into MGMT, SERVERS, and IOT with zero Wi-Fi downtime.",
    skills: ["TCP/IP", "VLANs", "OPNsense", "DNS", "DHCP", "VPN", "SonicWall"],
    projectSlug: "networking-lab",
  },

  {
    title: "Security",
    description:
      "The tools standing between client environments and whatever's trying to get in — deployed, monitored, and occasionally the reason I'm still troubleshooting after 5pm.",
    skills: [
      "SentinelOne",
      "Huntress",
      "Guardz",
      "Barracuda",
      "Endpoint Protection",
    ],
  },

  {
    title: "Automation & Development",
    description:
      "18 scripts and counting. If I do something by hand more than twice, it becomes a PowerShell script with a param block.",
    skills: ["PowerShell", "Git", "GitHub", "VS Code", "Scripting"],
    projectSlug: "powershell-automation",
  },

  {
    title: "IT Operations",
    description:
      "The unglamorous half of the job — documentation, ticket hygiene, and making sure the next tech (or future me) isn't guessing what a client's setup looks like.",
    skills: [
      "NinjaOne",
      "Remote Support",
      "Hardware Troubleshooting",
      "Software Deployment",
      "Documentation",
      "Customer Support",
    ],
  },
];
---

<section id="skills" class="skills">
  <SectionHeading title="Skills & Technologies" command="04 — ./arsenal.sh" />

  <div class="skills-grid">
    {
      skillGroups.map((group) => (
        <div class="skill-card">
          <h3>{group.title}</h3>

          <p class="card-description">{group.description}</p>

          <div class="badges">
            {group.skills.map((skill) => (
              <Badge>{skill}</Badge>
            ))}
          </div>

          {group.projectSlug && (
            <a href={`/projects/${group.projectSlug}`} class="evidence-link">
              See it in a project →
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills {
    padding: 5rem 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .skill-card {
    background: var(--surface-card);
    border: 1px solid var(--border-alt);
    border-radius: 14px;
    padding: 2rem;
    transition: all 0.25s ease;
  }

  .skill-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 12px 32px rgba(var(--accent-rgb), 0.15);
  }

  .skill-card h3 {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: 1.3rem;
  }

  .card-description {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .evidence-link {
    display: inline-block;
    margin-top: 1.5rem;

    color: var(--accent-light);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;

    transition: color 0.2s ease;
  }

  .evidence-link:hover {
    color: var(--accent-lighter);
  }

  @media (max-width: 768px) {
    .skills {
      padding: 5rem 0;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
