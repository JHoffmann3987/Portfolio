---
const projects = [
  {
    category: "Infrastructure",
    title: "Proxmox Home Lab",
    href: "/projects/proxmox-homelab",
    description:
      "Built a virtualized home lab using Proxmox VE to gain hands-on experience with enterprise infrastructure, virtualization, Linux administration, storage, and networking. The environment serves as the foundation for all of my self-hosted services and ongoing learning.",
    highlights: [
      "Virtual Machines & LXC Containers",
      "Shared SMB Storage",
      "Docker Integration",
      "Snapshot & Backup Management",
      "Linux Administration",
    ],
    tags: ["Proxmox VE", "Docker", "Ubuntu", "Linux", "Networking"],
  },

  {
    category: "Self Hosting",
    title: "Docker Services",
    href: "/projects/docker-services",
    description:
      "Designed and deployed a collection of Docker containers to host production-like services while learning container management, reverse proxies, monitoring, and service reliability.",
    highlights: [
      "Homepage Dashboard",
      "Jellyfin Media Server",
      "Uptime Kuma",
      "Vaultwarden",
      "Nginx Proxy Manager",
    ],
    tags: ["Docker", "Docker Compose", "Linux", "Reverse Proxy", "Monitoring"],
  },

  {
    category: "Microsoft 365",
    title: "Microsoft 365 Administration",
    href: "/projects/microsoft-365",
    description:
      "Support Microsoft 365 environments for business clients in an MSP setting, including identity management, Exchange Online, licensing, security, and user administration.",
    highlights: [
      "Exchange Online",
      "Entra ID",
      "User Provisioning",
      "Licensing",
      "Multi-Factor Authentication",
    ],
    tags: ["Microsoft 365", "Exchange", "Entra ID", "PowerShell"],
  },
];
---

<section id="projects" class="projects">
  <div class="section-heading">
    <span class="line"></span>

    <div>
      <p class="section-number">03.</p>
      <h2>Featured Projects</h2>
    </div>
  </div>

  <p class="intro">
    These projects represent the technologies I use professionally and the
    infrastructure I build in my home lab to continue expanding my skills. Every
    project focuses on solving real problems while improving reliability,
    automation, and operational knowledge.
  </p>

  <div class="project-list">
    {
      projects.map((project) => (
        <a href={project.href} class="project-card">
          <div class="project-header">
            <div>
              <p class="overline">{project.category}</p>

              <h3>{project.title}</h3>
            </div>

            <span class="arrow">→</span>
          </div>

          <p class="description">{project.description}</p>

          <ul class="highlights">
            {project.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="tags">
            {project.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>

          <div class="view-project">View Project →</div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding: 8rem 0;
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .line {
    width: 60px;
    height: 2px;
    background: #3b82f6;
    margin-top: 0.9rem;
    flex-shrink: 0;
  }

  .section-number {
    margin: 0;
    color: #3b82f6;
    font-family: monospace;
    font-size: 0.9rem;
  }

  .section-heading h2 {
    margin: 0.35rem 0 0;
    color: #f8fafc;
    font-size: 2rem;
  }

  .intro {
    max-width: 760px;
    color: #94a3b8;
    line-height: 1.9;
    margin-bottom: 3rem;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;

    background: #112240;

    border: 1px solid #233554;

    border-radius: 14px;

    padding: 2rem;

    transition: all 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);

    border-color: #3b82f6;

    box-shadow: 0 12px 30px rgba(59, 130, 246, 0.12);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    margin-bottom: 1rem;
  }

  .overline {
    color: #3b82f6;

    text-transform: uppercase;

    letter-spacing: 0.12em;

    font-size: 0.8rem;

    font-weight: 700;

    margin-bottom: 0.5rem;
  }

  .project-header h3 {
    color: #f8fafc;

    margin: 0;

    font-size: 1.7rem;
  }

  .arrow {
    color: #3b82f6;

    font-size: 2rem;

    transition: transform 0.25s;
  }

  .project-card:hover .arrow {
    transform: translateX(6px);
  }

  .description {
    color: #94a3b8;

    line-height: 1.8;

    margin-bottom: 1.5rem;
  }

  .highlights {
    color: #cbd5e1;

    line-height: 1.9;

    margin: 0 0 2rem 1.25rem;
  }

  .highlights li {
    margin-bottom: 0.5rem;
  }

  .tags {
    display: flex;

    flex-wrap: wrap;

    gap: 0.75rem;
  }

  .tags span {
    background: rgba(59, 130, 246, 0.12);

    border: 1px solid rgba(59, 130, 246, 0.2);

    color: #60a5fa;

    padding: 0.45rem 0.9rem;

    border-radius: 999px;

    font-size: 0.85rem;

    font-weight: 600;
  }

  .view-project {
    margin-top: 2rem;

    color: #60a5fa;

    font-weight: 600;
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 0;
    }

    .project-header {
      flex-direction: column;
      gap: 1rem;
    }

    .arrow {
      display: none;
    }
  }
</style>
