---
import SectionHeading from "./ui/SectionHeading.astro";
import Badge from "./ui/Badge.astro";

const projects = [
  {
    category: "Infrastructure",
    title: "Proxmox Home Lab",
    href: "/projects/proxmox-homelab",
    description:
      "Built and maintain a Proxmox virtualization environment to gain hands-on experience with enterprise infrastructure, virtualization, Linux administration, storage, networking, and self-hosted services. This environment serves as the foundation for all of my home lab projects.",
    highlights: [
      "Virtual Machines & LXC Containers",
      "Shared SMB Storage",
      "Docker Integration",
      "Snapshots & Backups",
      "Linux Administration",
    ],
    tags: ["Proxmox VE", "Docker", "Ubuntu", "Linux", "Networking"],
  },

  {
    category: "Self Hosting",
    title: "Docker Services",
    href: "/projects/docker-services",
    description:
      "Designed and deployed multiple Docker services to improve monitoring, media management, password security, and overall reliability while learning containerized application deployment.",
    highlights: [
      "Homepage Dashboard",
      "Jellyfin",
      "Vaultwarden",
      "Uptime Kuma",
      "Nginx Proxy Manager",
    ],
    tags: ["Docker", "Docker Compose", "Linux", "Reverse Proxy", "Monitoring"],
  },

  {
    category: "Administration",
    title: "Microsoft 365 Administration",
    href: "/projects/microsoft-365",
    description:
      "Provide daily administration and support for Microsoft 365 environments in a Managed Service Provider (MSP) setting, helping business clients manage identities, licensing, Exchange Online, and security.",
    highlights: [
      "Exchange Online",
      "Entra ID",
      "Microsoft 365 Licensing",
      "Multi-Factor Authentication",
      "User Provisioning",
    ],
    tags: ["Microsoft 365", "Exchange", "Entra ID", "PowerShell"],
  },
];
---

<section id="projects" class="projects">
  <SectionHeading
    number="03."
    title="Featured Projects"
    description="Projects that demonstrate my hands-on experience with virtualization, Microsoft 365 administration, Linux, Docker, and enterprise infrastructure."
  />

  <div class="project-list">
    {
      projects.map((project) => (
        <a href={project.href} class="project-card">
          <div class="project-header">
            <div>
              <p class="overline">{project.category}</p>
              <h3>{project.title}</h3>
            </div>

            <span class="arrow">→</span>
          </div>

          <p class="description">{project.description}</p>

          <ul class="highlights">
            {project.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="tags">
            {project.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </div>

          <div class="view-project">View Project →</div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding: 8rem 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;

    background: #112240;
    border: 1px solid #233554;
    border-radius: 14px;

    padding: 2rem;

    transition: all 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: #3b82f6;
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.15);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    margin-bottom: 1rem;
  }

  .overline {
    color: #3b82f6;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .project-header h3 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.7rem;
  }

  .arrow {
    color: #3b82f6;
    font-size: 2rem;
    transition: transform 0.25s ease;
  }

  .project-card:hover .arrow {
    transform: translateX(6px);
  }

  .description {
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .highlights {
    color: #cbd5e1;
    line-height: 1.8;
    margin: 0 0 2rem 1.25rem;
  }

  .highlights li {
    margin-bottom: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .view-project {
    margin-top: 2rem;
    color: #60a5fa;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .project-card:hover .view-project {
    color: #93c5fd;
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 0;
    }

    .project-header {
      flex-direction: column;
      gap: 1rem;
    }

    .arrow {
      display: none;
    }

    .project-header h3 {
      font-size: 1.5rem;
    }
  }
</style>
