---
import SectionHeading from "./ui/SectionHeading.astro";
import Badge from "./ui/Badge.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="projects">
  <SectionHeading
    title="Featured Projects"
    description="Projects that demonstrate my hands-on experience with virtualization, Microsoft 365 administration, Linux, Docker, and enterprise infrastructure."
  />

  <div class="project-list">
    {
      projects.map((project) => (
        <a href={`/projects/${project.slug}`} class="project-card">
          <div class="project-header">
            <div>
              <p class="overline">{project.category}</p>
              <h3>{project.title}</h3>
            </div>

            <span class="arrow">→</span>
          </div>

          <p class="description">{project.description}</p>

          <ul class="highlights">
            {project.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="tags">
            {project.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </div>

          <div class="view-project">View Project →</div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding: 8rem 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;

    background: var(--surface-card);
    border: 1px solid var(--border-alt);
    border-radius: 14px;

    padding: 2rem;

    transition: all 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 12px 32px rgba(var(--accent-rgb), 0.15);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    margin-bottom: 1rem;
  }

  .overline {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .project-header h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.7rem;
  }

  .arrow {
    color: var(--accent);
    font-size: 2rem;
    transition: transform 0.25s ease;
  }

  .project-card:hover .arrow {
    transform: translateX(6px);
  }

  .description {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .highlights {
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 2rem 1.25rem;
  }

  .highlights li {
    margin-bottom: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .view-project {
    margin-top: 2rem;
    color: var(--accent-light);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .project-card:hover .view-project {
    color: var(--accent-lighter);
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 0;
    }

    .project-header {
      flex-direction: column;
      gap: 1rem;
    }

    .arrow {
      display: none;
    }

    .project-header h3 {
      font-size: 1.5rem;
    }
  }
</style>
