---
import { profile } from "../data/profile";
---

<section class="hero" id="hero">
  <p class="eyebrow">Hi, I'm Justin.</p>

  <h1>
    Building Reliable<br />
    IT Infrastructure.
  </h1>

  <div class="description">
    <p>
      I'm an IT Technician in a Managed Service Provider environment,
      keeping Microsoft 365, Windows, and endpoint security running for
      business clients day to day.
    </p>

    <p>
      Off the clock I run a Proxmox lab — Linux, Docker, networking,
      PowerShell. I break things there so I don't have to learn on a client's
      network.
    </p>
  </div>

  <div class="hero-buttons">
    <a
      class="primary"
      href={profile.resumeHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      View Resume
    </a>

    <a class="secondary" href="#projects"> View Projects </a>
  </div>

  <div class="stat-strip">
    {
      profile.stats.map((stat) => (
        <div class="stat">
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </div>

  <div class="facts-terminal">
    <div class="terminal-bar">
      <span class="dot red" />
      <span class="dot amber" />
      <span class="dot green" />
      <span class="terminal-title">justin@homelab: ~</span>
    </div>

    <div class="terminal-body">
      <p class="prompt-line">
        <span class="prompt">justin@homelab:~$</span> cat ./facts
      </p>

      {
        profile.terminalFacts.map((fact) => (
          <p class="fact-line">
            <span class="fact-key">{fact.key}</span>
            <span class="fact-dots" />
            <span class="fact-value">{fact.value}</span>
          </p>
        ))
      }

      <p class="prompt-line blink-line">
        <span class="prompt">justin@homelab:~$</span> <span class="cursor" />
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;

    max-width: 760px;

    padding: 6rem 0 3rem;
  }

  .stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;

    margin-top: 3.5rem;
    padding-top: 2.5rem;

    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-value {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
  }

  .stat-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .facts-terminal {
    margin-top: 3rem;

    border: 1px solid var(--border-strong);
    border-radius: 10px;
    overflow: hidden;

    background: #0f1115;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    padding: 0.7rem 1rem;

    background: var(--surface-alt);
    border-bottom: 1px solid var(--border-strong);
  }

  .terminal-bar .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot.red {
    background: #ff5f56;
  }

  .dot.amber {
    background: #ffbd2e;
  }

  .dot.green {
    background: #27c93f;
  }

  .terminal-title {
    margin-left: 0.5rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .terminal-body {
    padding: 1.25rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.9;
  }

  .prompt-line {
    margin: 0 0 0.5rem;
    color: var(--text-secondary);
  }

  .prompt {
    color: var(--accent);
  }

  .fact-line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
  }

  .fact-key {
    color: var(--accent-light);
    flex-shrink: 0;
    min-width: 90px;
  }

  .fact-dots {
    flex: 1;
    border-bottom: 1px dotted var(--border-hover);
    transform: translateY(-3px);
    min-width: 1rem;
  }

  .fact-value {
    color: var(--text);
    flex-shrink: 0;
  }

  .blink-line {
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1rem;
    background: var(--accent);
    transform: translateY(2px);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .eyebrow {
    color: var(--accent);

    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;

    font-size: 0.85rem;
    font-weight: 600;

    margin-bottom: 1rem;
  }

  .hero h1 {
    color: var(--text);

    font-size: clamp(3rem, 5vw, 4.4rem);

    line-height: 1.02;

    letter-spacing: -0.04em;

    margin: 0 0 2rem;
  }

  .description {
    display: flex;
    flex-direction: column;

    gap: 1.5rem;

    max-width: 620px;

    color: var(--text-muted);

    font-size: 1.1rem;

    line-height: 1.9;

    margin-bottom: 2.5rem;
  }

  .description p {
    margin: 0;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.9rem 1.6rem;

    border-radius: 10px;

    text-decoration: none;

    font-weight: 600;

    transition: all 0.25s ease;
  }

  .primary {
    background: var(--accent);
    color: var(--white);
  }

  .primary:hover {
    background: var(--accent-dark);
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-light);
    background: transparent;
  }

  .secondary:hover {
    background: rgba(var(--accent-rgb), 0.08);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: 4rem 0;
    }

    .hero h1 {
      font-size: clamp(2.6rem, 8vw, 3.8rem);
    }

    .description {
      font-size: 1rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .primary,
    .secondary {
      width: 100%;
    }

    .stat-strip {
      gap: 1.75rem;
    }

    .stat-value {
      font-size: 2rem;
    }

    .terminal-body {
      font-size: 0.8rem;
    }

    .fact-line {
      flex-wrap: wrap;
    }

    .fact-dots {
      display: none;
    }

    .fact-key {
      min-width: 78px;
    }
  }
</style>
