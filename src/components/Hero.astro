---
import { profile } from "../data/profile";
---

<section class="hero" id="hero">
  <p class="eyebrow">Hi, I'm Justin.</p>

  <h1>
    Building Reliable<br />
    IT Infrastructure.
  </h1>

  <div class="description">
    <p>
      I'm an IT Support Technician in a Managed Service Provider environment,
      keeping Microsoft 365, Windows, and endpoint security running for
      business clients day to day.
    </p>

    <p>
      Off the clock, I run a self-built Proxmox lab — Linux, Docker,
      networking, PowerShell — to learn by breaking things before I have to
      fix them for real.
    </p>
  </div>

  <div class="hero-buttons">
    <a
      class="primary"
      href={profile.resumeHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      View Resume
    </a>

    <a class="secondary" href="#projects"> View Projects </a>
  </div>
</section>

<style>
  .hero {
    min-height: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;

    max-width: 700px;

    padding: 6rem 0 3rem;
  }

  .eyebrow {
    color: var(--accent);

    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;

    font-size: 0.85rem;
    font-weight: 600;

    margin-bottom: 1rem;
  }

  .hero h1 {
    color: var(--text);

    font-size: clamp(3rem, 5vw, 4.4rem);

    line-height: 1.02;

    letter-spacing: -0.04em;

    margin: 0 0 2rem;
  }

  .description {
    display: flex;
    flex-direction: column;

    gap: 1.5rem;

    max-width: 620px;

    color: var(--text-muted);

    font-size: 1.1rem;

    line-height: 1.9;

    margin-bottom: 2.5rem;
  }

  .description p {
    margin: 0;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.9rem 1.6rem;

    border-radius: 10px;

    text-decoration: none;

    font-weight: 600;

    transition: all 0.25s ease;
  }

  .primary {
    background: var(--accent);
    color: var(--white);
  }

  .primary:hover {
    background: var(--accent-dark);
    transform: translateY(-2px);
  }

  .secondary {
    border: 1px solid var(--accent);
    color: var(--accent-light);
    background: transparent;
  }

  .secondary:hover {
    background: rgba(var(--accent-rgb), 0.08);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: 4rem 0;
    }

    .hero h1 {
      font-size: clamp(2.6rem, 8vw, 3.8rem);
    }

    .description {
      font-size: 1rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .primary,
    .secondary {
      width: 100%;
    }
  }
</style>
