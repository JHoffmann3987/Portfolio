---
import SectionHeading from "./ui/SectionHeading.astro";
import { profile } from "../data/profile";
---

<section id="about" class="about">
  <SectionHeading title="About Me" />

  <div class="about-content">
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}

    <div class="certifications">
      <span class="certs-label">Certifications</span>
      <div class="certs-list">
        {profile.certifications.map((cert) => <span>{cert}</span>)}
      </div>
    </div>

    <div class="tech-grid">
      {
        profile.techColumns.map((column) => (
          <div class="tech-column">
            <h3>{column.title}</h3>

            <ul>
              {column.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    padding: 5rem 0;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 760px;
  }

  .about-content p {
    color: var(--text-muted);
    line-height: 1.9;
    font-size: 1.05rem;
  }

  .about-content strong {
    color: var(--text);
    font-weight: 600;
  }

  .certifications {
    margin-top: 0.5rem;
  }

  .certs-label {
    display: block;
    margin-bottom: 0.75rem;

    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .certs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .certs-list span {
    padding: 0.4rem 0.85rem;

    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 6px;

    color: var(--accent-light);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .tech-column {
    background: var(--surface-card);
    border: 1px solid var(--border-alt);
    border-radius: 12px;
    padding: 1.75rem;
    transition: all 0.25s ease;
  }

  .tech-column:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.12);
  }

  .tech-column h3 {
    color: var(--text);
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }

  .tech-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tech-column li {
    color: var(--text-muted);
    padding: 0.45rem 0 0.45rem 1.25rem;
    position: relative;
  }

  .tech-column li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .about {
      padding: 5rem 0;
    }

    .tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
