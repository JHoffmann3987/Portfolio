---
import { profile } from "../data/profile";
---

<aside class="sidebar">
  <div class="intro">
    <div class="status">
      <span class="status-dot"></span>
      Open to opportunities
    </div>

    <h1>{profile.name}</h1>

    <h2>
      {profile.title}
      <span>{profile.tagline}</span>
    </h2>

    <p>
      Supporting business clients by day, building infrastructure by night —
      in a self-run Proxmox lab where I break things on purpose.
    </p>
  </div>

  <nav class="nav">
    <a href="#about">
      <span></span>
      About
    </a>

    <a href="#experience">
      <span></span>
      Experience
    </a>

    <a href="#projects">
      <span></span>
      Projects
    </a>

    <a href="#skills">
      <span></span>
      Skills
    </a>

    <a href="#contact">
      <span></span>
      Contact
    </a>
  </nav>

  <div class="social">
    <a href={profile.github} target="_blank" rel="noopener noreferrer">
      GitHub
    </a>

    <a href={profile.resumeHref} target="_blank" rel="noopener noreferrer">
      Resume
    </a>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;

    height: 100vh;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 3rem 2rem;
  }

  .intro h1 {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.05;

    color: var(--text);

    margin-bottom: 0.75rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    margin-bottom: 1.25rem;
    padding: 0.35rem 0.7rem;

    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 6px;
    background: rgba(var(--accent-rgb), 0.08);

    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent-light);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 rgba(var(--accent-rgb), 0.6);
    animation: pulse 2.2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.55);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(var(--accent-rgb), 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  .intro h2 {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;

    font-size: 1.2rem;
    font-weight: 600;

    color: var(--text-secondary);

    margin-bottom: 2rem;
  }

  .intro h2 span {
    font-size: 0.9rem;
    font-weight: 500;

    color: var(--text-muted);
  }

  .intro p {
    max-width: 300px;

    color: var(--text-muted);

    line-height: 1.8;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .nav a {
    display: flex;
    align-items: center;
    gap: 1rem;

    color: var(--text-muted);

    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;

    text-transform: uppercase;
    letter-spacing: 0.08em;

    transition: color 0.25s ease;
  }

  .nav span {
    width: 40px;
    height: 1px;

    background: var(--text-faint);

    transition: all 0.25s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a:hover span {
    width: 72px;
    background: var(--accent);
  }

  .social {
    display: flex;
    gap: 1.5rem;
  }

  .social a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .social a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .sidebar {
      position: relative;
      height: auto;
      padding: 2rem;
    }

    .nav {
      flex-direction: row;
      flex-wrap: wrap;
      margin: 2rem 0;
    }

    .nav span {
      display: none;
    }
  }
</style>
